layout {
    cwd "/home/glenn/SourceCode/playlisp"
    tab name="code" hide_floating_panes=true {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane split_direction="vertical" {
            pane name="editor" size="70%"
            pane name="terminal" size="30%"
        }
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="git" hide_floating_panes=true {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane split_direction="vertical" {
            pane name="git-log" size="40%"
            pane command="gilt" name="git-work" size="60%"
        }
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="monitor" hide_floating_panes=true {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane command="btop" name="btop"
        pane name="watch" size=4
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="scratch" hide_floating_panes=true {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane name="scratch"
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="nvim" hide_floating_panes=true {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane command="nvim" name="nvim"
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="clabber" focus=true hide_floating_panes=true {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane command="clabber" name="clabber" focus=true
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    new_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
}

