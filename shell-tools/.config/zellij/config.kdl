// ╔══════════════════════════════════════════════════╗
// ║  ZELLIJ — glenn's terminal cockpit              ║
// ╚══════════════════════════════════════════════════╝

theme "phosphor"
default_layout "dev"

// UI
pane_frames false
default_shell "bash"
simplified_ui false
mouse_mode true
copy_on_select true
scrollback_editor "/usr/bin/nvim"

// Session persistence
session_serialization true
auto_layout true

// Performance
styled_underlines true

// Keybindings — unbind Ctrl+g so it passes through to emacs
keybinds {
    locked {
        unbind "Ctrl g"
    }
    normal {
        unbind "Ctrl g"
        bind "Ctrl Alt g" { SwitchToMode "Locked"; }
    }
}

// Custom hacker theme — phosphor green on black
themes {
    phosphor {
        // Tab bar (top) — inactive tabs
        ribbon_unselected {
            base 0 180 0
            background 0 50 0
            emphasis_0 0 220 0
            emphasis_1 0 160 0
            emphasis_2 0 180 0
            emphasis_3 0 140 0
        }
        ribbon_selected {
            base 0 0 0
            background 0 200 0
            emphasis_0 0 255 0
            emphasis_1 0 0 0
            emphasis_2 0 40 0
            emphasis_3 180 255 180
        }
        // Status bar / tips
        text_unselected {
            base 0 200 0
            background 0 30 0
            emphasis_0 0 240 0
            emphasis_1 0 200 0
            emphasis_2 0 180 0
            emphasis_3 0 160 0
        }
        text_selected {
            base 0 0 0
            background 0 200 0
            emphasis_0 0 255 0
            emphasis_1 0 0 0
            emphasis_2 0 40 0
            emphasis_3 180 255 180
        }
        // Table headers / plugin UI
        table_title {
            base 0 255 0
            background 0 10 0
            emphasis_0 0 200 0
            emphasis_1 0 160 0
            emphasis_2 100 255 100
            emphasis_3 0 120 0
        }
        table_cell_unselected {
            base 0 160 0
            background 0 10 0
            emphasis_0 0 200 0
            emphasis_1 0 120 0
            emphasis_2 0 80 0
            emphasis_3 0 60 0
        }
        table_cell_selected {
            base 0 0 0
            background 0 180 0
            emphasis_0 0 255 0
            emphasis_1 0 0 0
            emphasis_2 0 40 0
            emphasis_3 200 255 200
        }
        // Frame / border colors
        frame_unselected {
            base 0 100 0
            background 0 0 0
            emphasis_0 0 120 0
            emphasis_1 0 80 0
            emphasis_2 0 100 0
            emphasis_3 0 60 0
        }
        frame_selected {
            base 0 255 0
            background 0 0 0
            emphasis_0 0 200 0
            emphasis_1 0 255 0
            emphasis_2 0 160 0
            emphasis_3 100 255 100
        }
        frame_highlight {
            base 0 255 65
            background 0 20 0
            emphasis_0 0 255 0
            emphasis_1 100 255 100
            emphasis_2 0 200 0
            emphasis_3 180 255 180
        }
        // Exit dialog
        exit_code_success {
            base 0 255 0
            background 0 20 0
            emphasis_0 0 200 0
            emphasis_1 100 255 100
            emphasis_2 0 160 0
            emphasis_3 0 120 0
        }
        exit_code_error {
            base 255 60 60
            background 40 0 0
            emphasis_0 255 100 100
            emphasis_1 200 0 0
            emphasis_2 255 60 60
            emphasis_3 180 0 0
        }
        // Multiplayer / shared
        multiplayer_user_colors {
            player_1 0 255 0
            player_2 0 200 200
            player_3 200 0 200
            player_4 200 200 0
            player_5 0 150 255
            player_6 255 150 0
            player_7 150 255 0
            player_8 255 0 150
        }
    }
}
